{
	"name": "@alohasocial/ui",
	"version": "0.8.0",
	"description": "Shared Vue 3 components, composables and HostBridge contract for Aloha Social hosts.",
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/SchBenedikt/core.git",
		"directory": "ui"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"style": "./dist/index.css",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./style.css": "./dist/index.css"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"peerDependencies": {
		"vue": "^3.5.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"@vitejs/plugin-vue": "^5.2.1",
		"@vue/test-utils": "^2.4.6",
		"jsdom": "^26.0.0",
		"typescript": "^5.7.2",
		"vite": "^6.0.0",
		"vitest": "^3.2.0",
		"vue": "^3.5.0",
		"vue-tsc": "^2.2.0"
	},
	"scripts": {
		"build": "vite build && vue-tsc -p tsconfig.build.json",
		"prepack": "npm run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "vue-tsc --noEmit -p tsconfig.json"
	}
}
