# Copy to .env and adjust. Real environment variables win over this file.
# Never commit .env.

# Public origin. All actor ids and WebFinger URLs derive from it.
ALOHASOCIAL_INSTANCE_URL=http://localhost:3000

# Optional: load this file after .env. Web setup writes it; Docker Compose
# points it at the persistent var volume. Real process variables still win.
# ALOHASOCIAL_ENV_FILE=var/.env
ALOHASOCIAL_INSTANCE_NAME="Aloha Social"
ALOHASOCIAL_INSTANCE_DESCRIPTION=
ALOHASOCIAL_CONTACT_EMAIL=

# SQLite (small installs) or PostgreSQL (preferred).
ALOHASOCIAL_DB_DSN=sqlite:var/server.sqlite
# ALOHASOCIAL_DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=alohasocial
ALOHASOCIAL_DB_USER=
ALOHASOCIAL_DB_PASSWORD=

# 32 bytes, base64 encoded. Leave empty to generate var/secret.key on first boot.
ALOHASOCIAL_SECRET_KEY=
ALOHASOCIAL_SECRET_KEY_FILE=var/secret.key

# Relative paths resolve against the project root, not the process working
# directory, so PHP-FPM (starting in public/) and the CLI agree. For an
# in-place updated bare-metal host, point all of these at an absolute
# directory outside the checkout, e.g. /srv/aloha-data, or use
# `scripts/install.sh --data-dir=/srv/aloha-data`.
ALOHASOCIAL_VAR_DIRECTORY=var
ALOHASOCIAL_BLOB_DIRECTORY=var/blobs

# Defaults to on when the instance URL is https.
ALOHASOCIAL_SECURE_COOKIES=
ALOHASOCIAL_SESSION_LIFETIME=604800
# Change this only when several instances share a hostname.
ALOHASOCIAL_SESSION_COOKIE_NAME=alohasocial_session

# Outbound mail (password reset). "log" writes complete .eml files to
# var/mail/ and needs no server; switch to "smtp" in production.
ALOHASOCIAL_MAIL_TRANSPORT=log
ALOHASOCIAL_MAIL_FROM=
ALOHASOCIAL_MAIL_LOG_DIR=var/mail
ALOHASOCIAL_SMTP_HOST=
ALOHASOCIAL_SMTP_PORT=587
ALOHASOCIAL_SMTP_USER=
ALOHASOCIAL_SMTP_PASSWORD=
ALOHASOCIAL_SMTP_ENCRYPTION=starttls

ALOHASOCIAL_REMOTE_MEDIA=true
# Public self-registration. Approval leaves new accounts disabled until an
# administrator enables them.
ALOHASOCIAL_REGISTRATIONS=false
ALOHASOCIAL_REGISTRATION_APPROVAL=true
# Core dependency policy: "main" follows the development branch, "release"
# pins ALOHASOCIAL_CORE_VERSION from a tagged Core release.
ALOHASOCIAL_CORE_CHANNEL=main
ALOHASOCIAL_CORE_VERSION=
ALOHASOCIAL_MASTODON_API=true
ALOHASOCIAL_MASTODON_PREFIX=/api/mastodon/v1
# Public Mastodon-compatible instance for federated keyword/hashtag search.
# Leave empty to disable it; Bluesky search uses the public AppView regardless.
ALOHASOCIAL_DISCOVERY_INSTANCE=mastodon.social

# Optional native AT Protocol PDS. When enabled, members can create their own
# did:plc identity and handle instead of only linking an existing Bluesky account.
ALOHASOCIAL_ATPROTO_PDS=false
ALOHASOCIAL_ATPROTO_PDS_URL=
ALOHASOCIAL_ATPROTO_PDS_HANDLE_DOMAIN=
ALOHASOCIAL_ATPROTO_PLC_URL=https://plc.directory

# Docker only: create the first admin on start. Leave empty to create accounts
# manually with `php bin/create-account.php`.
# ALOHASOCIAL_ADMIN_HANDLE=admin
# ALOHASOCIAL_ADMIN_EMAIL=admin@example.com
# ALOHASOCIAL_ADMIN_PASSWORD=replace-with-a-strong-secret
# ALOHASOCIAL_ADMIN_DISPLAY_NAME=Admin
# Docker only: host port published by docker compose.
# ALOHASOCIAL_PORT=3000

ALOHASOCIAL_DEBUG=false
