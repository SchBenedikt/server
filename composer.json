{
    "name": "alohasocial/server",
    "description": "Standalone Aloha Social host: accounts, sessions, migrations, worker and the core HTTP contract.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "keywords": [
        "activitypub",
        "fediverse",
        "at-protocol",
        "alohasocial"
    ],
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "alohasocial/core": "^0.8.0",
        "aws/aws-sdk-php": "^3.400",
        "guzzlehttp/psr7": "^2.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/SchBenedikt/core",
            "no-api": true
        }
    ],
    "autoload": {
        "psr-4": {
            "AlohaSocial\\Server\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlohaSocial\\Server\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "smoke:federation": "@php bin/federation-smoke.php",
        "check": [
            "@test",
            "@smoke:federation"
        ]
    },
    "config": {
        "allow-plugins": {},
        "platform": {
            "php": "8.3.32"
        },
        "sort-packages": true,
        "github-protocols": ["https"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
